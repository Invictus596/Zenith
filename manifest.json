{
  "manifest_version": 3,
  "name": "Zenith",
  "version": "0.1.0",
  "description": "Functional aesthetic tweaks and focus modes for web applications.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://github.com/*",
    "*://chatgpt.com/*",
    "*://*.youtube.com/*",
    "*://reddit.com/*",
    "*://x.com/*",
    "*://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://github.com/*",
        "*://chatgpt.com/*",
        "*://*.youtube.com/*",
        "*://reddit.com/*",
        "*://x.com/*",
        "*://gemini.google.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}